CREATE PROCEDURE sp_UpdateProduct
    @ProductID   INT,
    @ProductName VARCHAR(100),
    @Category    VARCHAR(50),
    @Price       DECIMAL(10,2),
    @Quantity    INT,
    @MinStock    INT
AS
BEGIN
    UPDATE Products
    SET ProductName = @ProductName,
        Category    = @Category,
        Price       = @Price,
        Quantity    = @Quantity,
        MinStock    = @MinStock,
        UpdatedAt   = GETDATE()
    WHERE ProductID = @ProductID;
END

