[12:40 am, 29/05/2026] Saim CSE: CREATE PROCEDURE sp_GetAllProducts
AS
BEGIN
    SELECT p.ProductID,
           p.ProductName,
           p.Category,
           p.Price,
           p.Quantity,
           p.MinStock,
           s.SupplierName
    FROM   Products p
    LEFT JOIN Suppliers s ON p.SupplierID = s.SupplierID
    ORDER BY p.ProductName;
END
