CREATE PROCEDURE sp_SearchProducts
    @SearchTerm VARCHAR(100)
AS
BEGIN
    SELECT p.ProductID,
           p.ProductName,
           p.Category,
           p.Price,
           p.Quantity,
           p.MinStock,
           s.SupplierName
    FROM   Products p
    LEFT JOIN Suppliers s ON p.SupplierID = s.SupplierID
    WHERE  p.ProductName LIKE '%' + @SearchTerm + '%'
       OR  p.Category    LIKE '%' + @SearchTerm + '%';
END

CREATE TRIGGER trg_LogQuantityChange
ON Products
AFTER UPDATE
AS
BEGIN
    IF UPDATE(Quantity)
    BEGIN
        INSERT INTO Transactions
            (ProductID, UserID, TransType, Quantity, Note)
        SELECT
            i.ProductID,
            1,
            CASE WHEN i.Quantity > d.Quantity THEN 'IN' ELSE 'OUT' END,
            ABS(i.Quantity - d.Quantity),
            'Auto-logged by system'
        FROM inserted i
        JOIN deleted  d ON i.ProductID = d.ProductID;
    END
END



CREATE PROCEDURE sp_ChangePassword
    @UserID      INT,
    @OldPassword VARCHAR(255),
    @NewPassword VARCHAR(255)
AS
BEGIN
    IF EXISTS (
        SELECT 1 FROM Users
        WHERE UserID   = @UserID
          AND Password = @OldPassword
    )
    BEGIN
        UPDATE Users
        SET Password = @NewPassword
        WHERE UserID = @UserID;

        SELECT 'SUCCESS' AS Result;
    END
    ELSE
    BEGIN
        SELECT 'WRONG_PASSWORD' AS Result;
    END
END

