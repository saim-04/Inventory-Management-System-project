ALTER PROCEDURE sp_ChangePassword
    @UserID      INT,
    @OldPassword VARCHAR(255),
    @NewPassword VARCHAR(255)
AS
BEGIN
    IF EXISTS (
        SELECT 1 FROM Users
        WHERE UserID = @UserID
          AND Password = CONVERT(VARCHAR(64),
              HASHBYTES('SHA2_256', @OldPassword), 2)
    )
    BEGIN
        UPDATE Users
        SET Password = CONVERT(VARCHAR(64),
            HASHBYTES('SHA2_256', @NewPassword), 2)
        WHERE UserID = @UserID;

        SELECT 'SUCCESS' AS Result;
    END
    ELSE
    BEGIN
        SELECT 'WRONG_PASSWORD' AS Result;
    END
END
GO


ALTER PROCEDURE sp_LoginUser
    @Username VARCHAR(50),
    @Password VARCHAR(255)
AS
BEGIN
    SELECT UserID, Username, FullName, Role
    FROM   Users
    WHERE  Username = @Username
      AND  Password = CONVERT(VARCHAR(64),
           HASHBYTES('SHA2_256', @Password), 2);
END
GO




CREATE PROCEDURE sp_AddSupplier
    @SupplierName VARCHAR(100),
    @Phone        VARCHAR(20),
    @Email        VARCHAR(100),
    @Address      VARCHAR(255)
AS
BEGIN
    INSERT INTO Suppliers (SupplierName, Phone, Email, Address)
    VALUES (@SupplierName, @Phone, @Email, @Address);
    SELECT SCOPE_IDENTITY() AS NewSupplierID;
END
GO

CREATE PROCEDURE sp_GetAllSuppliers
AS
BEGIN
    SELECT SupplierID, SupplierName, Phone, Email, Address
    FROM   Suppliers
    ORDER BY SupplierName;
END
GO
